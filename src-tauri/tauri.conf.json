{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenMetric",
  "version": "0.1.0",
  "identifier": "org.genmetric.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GenMetric — индексатор метрических книг",
        "width": 470,
        "height": 980,
        "minWidth": 380,
        "minHeight": 560,
        "x": 40,
        "y": 30,
        "resizable": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/seed.sqlite"],
    "copyright": "GenMetric, лицензия GPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Индексатор метрических книг",
    "longDescription": "Программа для ускоренного набора метрических книг: автоподстановка имён, званий и населённых пунктов, выгрузка в формате Familio."
  }
}
