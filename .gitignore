# --- Исходный Excel-Индексатор в репозиторий не выкладывается ---------------
# Это работа стороннего автора (А.К., t.me/LinesOfTime). Разрешение получено
# на использование справочников и логики в этой программе, но не на публикацию
# самого файла. Справочники хранятся текстом в db/seed/*.csv.
*.xlsm
*.xls
*.xlsb

# --- Собранная база данных --------------------------------------------------
# Собирается из db/seed/*.csv командой  python3 db/build_seed.py
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# --- Сборка -----------------------------------------------------------------
node_modules/
dist/
build/
target/
*.exe
*.msi
*.dmg
*.app
*.AppImage

# --- Служебное --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Ресурсы, которые собираются автоматически
src-tauri/resources/*.sqlite
src-tauri/gen/
